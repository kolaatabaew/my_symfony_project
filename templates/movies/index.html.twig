<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>Кинокаталог</title>
</head>
<body>
    <?php if ($page === 'index'): ?>
        <p><a href="/movies/random">Случайный фильм</a></p>
        
        <h1>Главная страница каталога</h1>
        <table border="1" cellpadding="5" cellspacing="0">
            <thead>
                <tr>
                    <th>Название</th>
                    <th>Год</th>
                    <th>Действие</th>
                </tr>
            </thead>
            <tbody>
                <?php foreach ($movies as $movie): ?>
                    <tr>
                        <td><?php echo $movie['title']; ?></td>
                        <td><?php echo $movie['year']; ?></td>
                        <td><a href="/movies/<?php echo $movie['id']; ?>">Подробнее</a></td>
                    </tr>
                <?php endforeach; ?>
            </tbody>
        </table>
    <?php elseif ($page === 'show'): ?>
        <h1><?php echo $movie['title']; ?></h1>
        <p><b>Год выпуска:</b> <?php echo $movie['year']; ?></p>
        <p><b>Описание:</b> <?php echo $movie['description']; ?></p>
        <a href="/movies">Назад к списку фильмов</a>
    <?php endif; ?>
</body>
</html>
